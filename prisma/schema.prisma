generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MANAGER
  WAITER
  KITCHEN
}

enum OrderSource {
  QR
  WAITER
  POS
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  BILLING
}

model Tenant {
  id          String       @id @default(dbgenerated("gen_random_uuid()::text"))
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  users       User[]
  restaurants Restaurant[]
  staffInvites StaffInvite[]
}

model Restaurant {
  id         String             @id @default(dbgenerated("gen_random_uuid()::text"))
  tenantId   String
  name       String
  slug       String             @unique
  city       String
  timezone   String             @default("Asia/Kolkata")
  createdAt  DateTime           @default(now())
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users      User[]
  tables     RestaurantTable[]
  categories MenuCategory[]
  menuItems  MenuItem[]
  orders     Order[]
  staffInvites StaffInvite[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()::text"))
  tenantId     String
  restaurantId String
  name         String
  email        String       @unique
  passwordHash String
  role         UserRole
  active       Boolean      @default(true)
  authVersion  Int          @default(0)
  createdAt    DateTime     @default(now())
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurant   Restaurant   @relation(fields: [restaurantId, tenantId], references: [id, tenantId], onDelete: Cascade)
  orders       Order[]
  kotEvents    KotEvent[]
  createdInvites StaffInvite[] @relation("StaffInviteCreator")

  @@unique([id, tenantId])
  @@index([restaurantId, tenantId])
}

model StaffInvite {
  id           String     @id @default(dbgenerated("gen_random_uuid()::text"))
  tenantId     String
  restaurantId String
  role         UserRole
  tokenHash    String     @unique
  createdById  String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy    User       @relation("StaffInviteCreator", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, restaurantId, expiresAt])
}

model RestaurantTable {
  id           String       @id @default(dbgenerated("gen_random_uuid()::text"))
  tenantId     String
  restaurantId String
  number       String
  seats        Int
  status       TableStatus  @default(AVAILABLE)
  active       Boolean      @default(true)
  publicQrToken String      @unique @default(dbgenerated("gen_random_uuid()::text"))
  restaurant   Restaurant   @relation(fields: [restaurantId, tenantId], references: [id, tenantId], onDelete: Cascade)
  orders       Order[]

  @@unique([id, restaurantId, tenantId])
  @@unique([restaurantId, tenantId, number])
  @@index([restaurantId, tenantId, active])
}

model MenuCategory {
  id           String       @id @default(dbgenerated("gen_random_uuid()::text"))
  tenantId     String
  restaurantId String
  name         String
  sortOrder    Int          @default(0)
  restaurant   Restaurant   @relation(fields: [restaurantId, tenantId], references: [id, tenantId], onDelete: Cascade)
  items        MenuItem[]

  @@unique([id, restaurantId, tenantId])
  @@unique([restaurantId, tenantId, name])
}

model MenuItem {
  id           String       @id @default(dbgenerated("gen_random_uuid()::text"))
  tenantId     String
  restaurantId String
  categoryId   String
  name         String
  description  String       @default("")
  price        Decimal      @db.Decimal(10, 2)
  vegetarian   Boolean      @default(false)
  available    Boolean      @default(true)
  active       Boolean      @default(true)
  imageUrl     String?
  createdAt    DateTime     @default(now())
  restaurant   Restaurant   @relation(fields: [restaurantId, tenantId], references: [id, tenantId], onDelete: Cascade)
  category     MenuCategory @relation(fields: [categoryId, restaurantId, tenantId], references: [id, restaurantId, tenantId], onDelete: Restrict)
  orderItems   OrderItem[]

  @@unique([id, restaurantId, tenantId])
  @@unique([restaurantId, tenantId, name])
  @@index([restaurantId, tenantId, available, active])
}

model Order {
  id           String       @id @default(dbgenerated("gen_random_uuid()::text"))
  number       Int
  tenantId     String
  restaurantId String
  tableId      String?
  userId       String?
  source       OrderSource
  status       OrderStatus  @default(NEW)
  notes        String       @default("")
  totalAmount  Decimal      @db.Decimal(10, 2)
  paymentStatus PayStatus   @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  restaurant   Restaurant   @relation(fields: [restaurantId, tenantId], references: [id, tenantId], onDelete: Cascade)
  table        RestaurantTable? @relation(fields: [tableId, restaurantId, tenantId], references: [id, restaurantId, tenantId], onDelete: Restrict)
  user         User?        @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  items        OrderItem[]
  kot          KotTicket?
  payments     Payment[]

  @@unique([id, restaurantId, tenantId])
  @@unique([restaurantId, tenantId, number])
  @@index([restaurantId, tenantId, status, createdAt])
}

model OrderItem {
  id           String       @id @default(dbgenerated("gen_random_uuid()::text"))
  tenantId     String
  restaurantId String
  orderId      String
  menuItemId   String
  itemName     String
  quantity     Int
  unitPrice    Decimal      @db.Decimal(10, 2)
  order        Order        @relation(fields: [orderId, restaurantId, tenantId], references: [id, restaurantId, tenantId], onDelete: Cascade)
  menuItem     MenuItem     @relation(fields: [menuItemId, restaurantId, tenantId], references: [id, restaurantId, tenantId], onDelete: Restrict)

  @@index([orderId])
}

model KotTicket {
  id           String       @id @default(dbgenerated("gen_random_uuid()::text"))
  tenantId     String
  restaurantId String
  orderId      String       @unique
  status       OrderStatus  @default(NEW)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events       KotEvent[]

  @@unique([id, restaurantId, tenantId])
}

model KotEvent {
  id           String       @id @default(dbgenerated("gen_random_uuid()::text"))
  tenantId     String
  restaurantId String
  ticketId     String
  actorId      String?
  status       OrderStatus
  note         String       @default("")
  createdAt    DateTime     @default(now())
  ticket       KotTicket    @relation(fields: [ticketId, restaurantId, tenantId], references: [id, restaurantId, tenantId], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

// 1) Add this enum + model to schema.prisma
enum PayStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id                String    @id @default(dbgenerated("gen_random_uuid()::text"))
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String    @default("razorpay")
  providerOrderId   String    @unique
  providerPaymentId String?   @unique
  amountPaise       Int
  currency          String    @default("INR")
  status            PayStatus @default(PENDING)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([orderId])
}
