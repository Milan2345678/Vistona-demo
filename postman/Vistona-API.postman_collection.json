    {
      "name": "05 - QR Ordering",
      "description": "Public endpoints. Run menu first to capture an available menuItemId, then create a QR order.",
      "item": [
        {
          "name": "Get public QR menu",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/qr/{{restaurantSlug}}/menu"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('public QR menu succeeds', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('menu contains available items only', function () { pm.expect(body.menu).to.be.an('array'); if (body.menu.length) pm.collectionVariables.set('menuItemId', body.menu[0].id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create public QR order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": \"{{tableNumber}}\",\n  \"notes\": \"Postman QR order\",\n  \"items\": [\n    { \"menuItemId\": \"{{menuItemId}}\", \"quantity\": 1 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/qr/{{restaurantSlug}}/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('public QR order is created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('server marks source QR', function () { pm.expect(body.order.source).to.eql('qr'); pm.expect(body.order.id).to.be.a('string'); });",
                  "if (body.order && body.order.id) pm.collectionVariables.set('qrOrderId', body.order.id);"
                ]
              }
            }
          ]
        }
      ]
    },
